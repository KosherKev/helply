{
  "name": "helply",
  "version": "0.1.0",
  "description": "Open-source customer support that understands Ghanaian languages and reads your logs to explain what went wrong.",
  "license": "MIT",
  "main": "src/server.js",
  "scripts": {
    "start": "node --experimental-sqlite src/server.js",
    "dev": "node --experimental-sqlite --watch src/server.js",
    "test": "node --experimental-sqlite --test",
    "seed": "node scripts/seed-logs.js",
    "check:khaya": "node scripts/check-khaya.js",
    "verify:live": "node scripts/verify-live.js",
    "dev:mock": "node --experimental-sqlite scripts/dev-mock-server.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "yaml": "^2.9.1"
  }
}
