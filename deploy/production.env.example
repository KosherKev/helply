# Copy to .env.production on the server (gitignored). Never commit real values.

# ── Site ────────────────────────────────────────────────
SITE_ADDRESS=helply.example.com       # your domain; DNS A record must point at the Droplet. Use :80 to test by IP
APP_URL=https://helply.example.com    # used in invitation and password-reset links
CORS_ORIGIN=https://helply.example.com
VITE_GITHUB_URL=https://github.com/your-org/helply
VITE_TWI_SAMPLE=                      # a real message from a native Twi speaker, or leave empty

# ── Mode ────────────────────────────────────────────────
# false for a real deployment. true seeds the fictional KwikPay demo, a known demo login, open sign-up and open console routes:
# fine for a hackathon demo URL, NEVER for customers' data.
DEMO_MODE=false
ALLOW_SIGNUP=false                    # true lets anyone create a workspace
DEMO_PASSWORD=                        # demo mode only: set your own, do not keep the default

# ── Secrets: generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" ──
HELPLY_ENCRYPTION_KEY=                # REQUIRED. Back this up: stored secrets cannot be decrypted without it
# Single-company self-hosting only: setting these two enables the built-in "default workspace" (env-configured identity secret and
# log source, legacy X-Console-Key). For a multi-company service leave BOTH empty and let each company register its own workspace.
HELPLY_JWT_SECRET=
CONSOLE_KEY=

# ── Model and language ──────────────────────────────────
GEMMA_API_KEY=
GEMMA_MODEL=gemma-4-31b-it
GEMMA_THINKING_LEVEL=minimal
KHAYA_API_KEY=

# ── Logs (central-logging-service) ──────────────────────
CLS_BASE_URL=https://logs.example.com   # must be reachable from the Droplet; use a READ-ONLY key
CLS_API_KEY=
CLS_SERVICE=demo-shop-api

# ── Email (password reset) ──────────────────────────────
EMAIL_SERVICE_URL=
EMAIL_API_KEY=
