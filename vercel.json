{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix web ci && npm --prefix site ci",
  "buildCommand": "npm --prefix site run build:all",
  "outputDirectory": "site/deploy",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.helplygh.online"
        }
      ],
      "destination": "https://helplygh.online/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "https://helply-pjww.onrender.com/v1/:path*"
    },
    {
      "source": "/health",
      "destination": "https://helply-pjww.onrender.com/health"
    },
    {
      "source": "/demo/:path*",
      "destination": "/demo/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/app/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=(self)"
        }
      ]
    }
  ]
}
