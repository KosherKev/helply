# ── Server ───────────────────────────────────────────────
PORT=8787
HELPLY_BRAND=Helply
# Allowed browser origin for the frontend (use * only for local demos)
CORS_ORIGIN=http://localhost:5173
# Enables POST /v1/demo/token and seeded demo knowledge. NEVER true in production.
DEMO_MODE=true
# Protects the support console API (/v1/tickets, /v1/knowledge). Required when DEMO_MODE=false.
CONSOLE_KEY=change-me

# ── Customer identity ────────────────────────────────────
# Shared secret between the company's backend (which signs a short-lived token for the
# logged-in user) and Helply (which verifies it). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HELPLY_JWT_SECRET=
TOKEN_MAX_AGE_SECONDS=900

# ── Logs (central-logging-service) ───────────────────────
CLS_BASE_URL=http://localhost:8080
# A key with the logs:read scope. Read-only. Never reuse a write key here.
CLS_API_KEY=
# Helply only ever reads this one service's logs.
CLS_SERVICE=demo-shop-api
# Only for `npm run seed` (needs logs:write)
CLS_WRITE_KEY=

# ── Model (Gemma 4 via the Gemini API, or your own self-hosted endpoint) ──
GEMMA_API_KEY=
# Use the exact model ID listed in Google AI Studio for Gemma 4.
GEMMA_MODEL=gemma-4-31b-it
GEMMA_BASE_URL=https://generativelanguage.googleapis.com
# Gemma 4 is a thinking model; "minimal" keeps reasoning tokens from eating the output budget (other values are rejected). Empty = omit.
GEMMA_THINKING_LEVEL=minimal

# ── Ghanaian language layer (GhanaNLP Khaya) ─────────────
# Optional. Without it, translation falls back to Gemma and is flagged lower confidence.
KHAYA_API_KEY=
KHAYA_BASE_URL=https://translation-api.ghananlp.org
# Verify with `npm run check:khaya` — see docs/ARCHITECTURE.md
KHAYA_TRANSLATE_PATH=/v1/translate

# ── v1.1: storage, secrets, accounts ─────────────────────
# SQLite file (needs Node >= 22.5, started with --experimental-sqlite: `npm start` does this). Empty = in-memory.
HELPLY_DB_PATH=.data/helply.db
# Encrypts log-source keys, webhook secrets and per-workspace signing secrets at rest. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HELPLY_ENCRYPTION_KEY=
# Allow POST /v1/auth/register (always on in demo mode)
ALLOW_SIGNUP=false
# Public URL of the dashboard (used in invitation links)
APP_URL=http://localhost:5173
# Behind DigitalOcean's proxy set the number of proxy hops (1) so rate limits see the real client IP
TRUST_PROXY=
# Demo owner login (demo mode only): owner@kwikpay.demo / this password
DEMO_PASSWORD=helply-demo-pass
# Let log sources / webhooks point at private addresses. Local development ONLY.
ALLOW_PRIVATE_LOG_SOURCES=false
ALLOW_INSECURE_WEBHOOKS=false
# Rate limits per minute
RATE_SUPPORT_IP=30
RATE_SUPPORT_WS=300
RATE_API_WS=600
RATE_LOGIN_IP=10

# ── Email (password reset). The HTTP email microservice: POST {EMAIL_SERVICE_URL}/send-email with header x-api-key ──
EMAIL_SERVICE_URL=
EMAIL_API_KEY=
